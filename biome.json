{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!drizzle",
      "!coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/**", "src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "src/lib and src/components reach the browser: keep zod schemas in src/server (src/server/actions/schemas.ts).",
                  "motion/react": {
                    "importNames": ["motion"],
                    "message": "Use `m` from \"motion/react\": LazyMotion (src/components/providers.tsx) loads the features, and `motion.*` would bring them all into the first load."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "motion/react": {
                    "importNames": ["motion"],
                    "message": "Use `m` from \"motion/react\": LazyMotion (src/components/providers.tsx) loads the features, and `motion.*` would bring them all into the first load."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
