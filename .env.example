# =============================================================================
# Prumo · variáveis de ambiente
#
# Desenvolvimento: `vercel env pull .env.local` (ou copie este arquivo para
# .env.local e preencha). Produção e preview: Vercel → Settings → Environment
# Variables. Toda mudança na Vercel só vale depois de um novo deploy.
#
# Nunca use o prefixo NEXT_PUBLIC_ em segredos: ele embute o valor no
# JavaScript enviado ao navegador.
#
# Para gerar um segredo aleatório (32 bytes):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#   ou: openssl rand -base64 32
# Tokens e segredos abaixo precisam de pelo menos 32 caracteres.
# =============================================================================

# --- Banco de dados (Neon) ---------------------------------------------------
# Injetadas pela integração Neon do Vercel Marketplace (um branch do banco por
# preview). Para desenvolver, use um branch próprio da Neon (ex.: "dev"), não o
# de produção.

# Conexão com pooling, usada pelo app.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Conexão direta (sem pooling), usada pelo drizzle-kit nas migrações.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Autenticação (Better Auth) ----------------------------------------------
# Assina sessões e cookies. Gere com o comando do topo. Trocar este valor
# encerra todas as sessões abertas.
BETTER_AUTH_SECRET=""
# Endereço público do app; as passkeys ficam vinculadas a este domínio.
# Local: http://localhost:3000 · Produção: https://seu-dominio
BETTER_AUTH_URL="http://localhost:3000"
# Opcional. Domínio (só o nome, sem https:// nem porta) que as passkeys usam.
# Vazio: o domínio de BETTER_AUTH_URL. Trocar o domínio invalida as passkeys.
PASSKEY_RP_ID=""
# Opcional. Outros endereços aceitos no login (ex.: o domínio antigo), separados
# por vírgula, sem espaços e sem curinga: https://antigo.vercel.app,https://www.exemplo.com
BETTER_AUTH_TRUSTED_ORIGINS=""

# --- Dono do app (não existe cadastro público) -------------------------------
# E-mail da primeira conta, a do dono, que administra o app. As outras contas
# entram por convite feito em Administração; a recuperação de emergência
# (/recuperar) vale para esta conta, que o painel não exclui nem redefine.
# Pode continuar definida depois do primeiro acesso; sem ela, o dono é a
# conta mais antiga (a do primeiro acesso).
OWNER_EMAIL=""
# Token de uso único para criar a primeira conta em /primeiro-acesso. Gere com o
# comando do topo (mínimo de 32 caracteres: com menos, a rota fica fechada), faça
# o primeiro acesso e APAGUE a variável em seguida.
SETUP_TOKEN=""
# Token de emergência para /recuperar (perdeu a passkey). Deixe vazio no dia a
# dia: defina só quando precisar (mínimo de 32 caracteres: com menos, a rota
# fica fechada) e apague assim que recuperar o acesso.
RECOVERY_TOKEN=""

# --- Privacidade (LGPD) ------------------------------------------------------
# Opcional. E-mail do canal do titular, mostrado em /termos e /privacidade.
# Use um e-mail de contato, não o de login do dono (OWNER_EMAIL): ele fica
# público. Lido no build: mudar exige novo deploy. Vazio: as páginas mandam
# falar com quem administra o app (quem enviou o convite).
PRIVACY_CONTACT_EMAIL=""

# --- Cron diário -------------------------------------------------------------
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" para /api/cron/daily.
# Sem este valor, toda chamada ao cron é recusada. Gere com o comando do topo.
CRON_SECRET=""

# --- Notificações (Web Push) -------------------------------------------------
# Par de chaves VAPID que identifica o app nos serviços de push (Apple, Google,
# Mozilla). Gere com: npx web-push generate-vapid-keys
# Sem as duas, Ajustes › Notificações avisa que o envio não está configurado e
# o passo sendReminders do cron diário (os avisos) é pulado.
# A pública vai ao navegador pela própria página (não use NEXT_PUBLIC_); a
# privada, nunca. Trocar o par invalida as inscrições: cada aparelho precisa
# ativar as notificações de novo.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Monitoramento (Sentry, opcional) ----------------------------------------
# DSN do projeto no painel do Sentry (Settings > Client Keys). Vazio = Sentry
# desligado. As duas variáveis levam o mesmo valor: SENTRY_DSN no servidor e
# NEXT_PUBLIC_SENTRY_DSN no navegador (DSN não é segredo, por isso o prefixo).
# Recomendado só em Production. A pública entra no build: trocar exige novo deploy.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Futuro (ainda não usados; descomente quando a funcionalidade chegar) ----
# Vercel Blob: comprovantes e arquivos de importação. Criado pela Vercel ao
# conectar um Blob store ao projeto.
# BLOB_READ_WRITE_TOKEN=""
#
# Resend: e-mails (resumo semanal, alertas). Crie a chave no painel do Resend.
# RESEND_API_KEY=""

# --- Entrar com Google --------------------------------------------------------
# Opcional, as duas ou nenhuma. Sem elas o botão "Continuar com o Google" nunca
# aparece. No Google Cloud: APIs e serviços › Credenciais › Criar ID do cliente
# OAuth, tipo "Aplicativo da Web"; origem = BETTER_AUTH_URL; URI de
# redirecionamento = BETTER_AUTH_URL + /api/auth/callback/google. Depois, ligue
# a flag entrar_com_google em Administração › Flags. Defina só no ambiente
# Production da Vercel (a URI dos previews muda a cada deploy).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Senhas vazadas -----------------------------------------------------------
# Opcional. Recusa senhas que aparecem no Have I Been Pwned (só os 5 primeiros
# caracteres do SHA-1 saem do servidor). Vazio = ligado. Use off só em testes ou
# para desenvolver sem internet; se o serviço estiver fora do ar, a senha é
# aceita.
PASSWORD_LEAK_CHECK=""
