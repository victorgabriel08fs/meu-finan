# =============================================================================
# Meu Finan · variáveis de ambiente
#
# Desenvolvimento: `vercel env pull .env.local` (ou copie este arquivo para
# .env.local e preencha). Produção e preview: Vercel → Settings → Environment
# Variables. Toda mudança na Vercel só vale depois de um novo deploy.
#
# Nunca use o prefixo NEXT_PUBLIC_ em segredos: ele embute o valor no
# JavaScript enviado ao navegador.
#
# Para gerar um segredo aleatório (32 bytes):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#   ou: openssl rand -base64 32
# Tokens e segredos abaixo precisam de pelo menos 32 caracteres.
# =============================================================================

# --- Banco de dados (Neon) ---------------------------------------------------
# Injetadas pela integração Neon do Vercel Marketplace (um branch do banco por
# preview). Para desenvolver, use um branch próprio da Neon (ex.: "dev"), não o
# de produção.

# Conexão com pooling, usada pelo app.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Conexão direta (sem pooling), usada pelo drizzle-kit nas migrações.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Autenticação (Better Auth) ----------------------------------------------
# Assina sessões e cookies. Gere com o comando do topo. Trocar este valor
# encerra todas as sessões abertas.
BETTER_AUTH_SECRET=""
# Endereço público do app; as passkeys ficam vinculadas a este domínio.
# Local: http://localhost:3000 · Produção: https://seu-dominio
BETTER_AUTH_URL="http://localhost:3000"

# --- Dono do app (não existe cadastro público) -------------------------------
# E-mail da primeira conta, a do dono, que administra o app. As outras contas
# entram por convite feito em Administração; a recuperação de emergência
# (/recuperar) vale para esta conta, que o painel não exclui nem redefine.
# Pode continuar definida depois do primeiro acesso; sem ela, o dono é a
# conta mais antiga (a do primeiro acesso).
OWNER_EMAIL=""
# Token de uso único para criar a primeira conta em /primeiro-acesso. Gere com o
# comando do topo, faça o primeiro acesso e APAGUE a variável em seguida.
SETUP_TOKEN=""
# Token de emergência para /recuperar (perdeu a passkey). Deixe vazio no dia a
# dia: defina só quando precisar e apague assim que recuperar o acesso.
RECOVERY_TOKEN=""

# --- Cron diário -------------------------------------------------------------
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" para /api/cron/daily.
# Sem este valor, toda chamada ao cron é recusada. Gere com o comando do topo.
CRON_SECRET=""

# --- Futuro (ainda não usados; descomente quando a funcionalidade chegar) ----
# Vercel Blob: comprovantes e arquivos de importação. Criado pela Vercel ao
# conectar um Blob store ao projeto.
# BLOB_READ_WRITE_TOKEN=""
#
# Web Push (lembretes). Gere o par com: npx web-push generate-vapid-keys
# A chave pública pode ir ao navegador; a privada, nunca.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:voce@exemplo.com"
#
# Resend: e-mails (resumo semanal, alertas). Crie a chave no painel do Resend.
# RESEND_API_KEY=""
#
# Sentry: monitoramento de erros. DSN do projeto no painel do Sentry.
# SENTRY_DSN=""
